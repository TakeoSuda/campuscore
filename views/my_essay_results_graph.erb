<h1>グラフ型自由英作文の添削結果</h1>

<% @grouped_essays.each do |essay_id, essays| %>
  <div>
    <h2><%= essays.first['title_graph'] %></h2>
    <p><strong>ユーザー:</strong> <%= essays.first['user_name'] %>さん</p>
    <p><strong>質問:</strong> <%= essays.first['question_graph'] %></p>
    <p><img src="<%= essays.first['image_graph'] %>" alt="問題画像" style="max-width: 100%; height: auto;"></p>
    <p><strong>提出した文章:</strong> <%= essays.first['answer_graph'] %></p>
    <p><strong>修正後の文章:</strong> <%= essays.first['corrected_answer_graph'] %></p>
    <p><strong>スコア:</strong> <%= essays.first['score'] %></p>
    <% essays.each do |essay| %>
      <p><strong>ミス:</strong> <%= essay['mistake'] %></p>
      <p><strong>理由:</strong> <%= essay['reason'] %></p>
    <% end %>
    <p><strong>フィードバック:</strong> <%= essays.first['feedback'] %></p>
    <p><strong>講師からのアドバイス:</strong> <%= essays.first['human_feedback'] %></p>
  </div>
<% end %>